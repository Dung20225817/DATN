# Copy file này thành terraform.tfvars và điền giá trị thật
# terraform.tfvars được gitignore và KHÔNG được commit

aws_region        = "ap-southeast-1"
project_name      = "ocr-crnn"
ec2_instance_type = "t3.medium"
ec2_volume_size   = 30

rds_instance_class = "db.t3.micro"
db_name            = "ocr_crnn"
db_username        = "ocr"
db_password        = "CHANGE_ME_USE_STRONG_PASSWORD"  # >= 8 chars, no special chars @ / : in URL

# Tên key pair đã tạo trong AWS Console → EC2 → Key Pairs
ec2_key_pair_name = "ocr-crnn-keypair"

# IP của bạn để SSH vào EC2. Tìm IP: curl ifconfig.me
# Dùng 0.0.0.0/0 nếu IP thay đổi thường xuyên (ít secure hơn)
my_ip_cidr = "YOUR_PUBLIC_IP/32"
