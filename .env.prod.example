# Tạo file .env.prod từ template này trên EC2 tại /home/ubuntu/ocr-crnn/.env.prod
# KHÔNG commit file .env.prod vào git

# DATABASE_URL từ: terraform output -raw database_url
DATABASE_URL=postgresql://ocr:YOUR_DB_PASSWORD@YOUR_RDS_HOSTNAME.ap-southeast-1.rds.amazonaws.com:5432/ocr_crnn

# Google OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# CORS: Vercel deployment URL (từ Vercel Dashboard)
# Nhiều domain cách nhau bởi dấu phẩy
ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app

# Docker image reference (dùng trong docker-compose.prod.yml)
DOCKER_IMAGE=YOUR_DOCKERHUB_USERNAME/ocr-crnn-backend
